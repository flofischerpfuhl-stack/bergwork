// Cloudflare static-assets deployment config.
// Build command (working directory website/): node build.mjs
// Generated deployment directory: website/dist. Do not deploy source files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bergwork",
  "compatibility_date": "2026-09-25",
  // worker.js only sends plain-HTTP page visits to HTTPS; app files and assets never invoke it.
  "main": "worker.js",
  "routes": [
    { "pattern": "bergwork.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/pdf/", "/pdf", "/image/", "/image", "/roadmap/", "/roadmap", "/download/", "/download", "/legal/", "/legal", "/privacy/", "/privacy", "/app/pdf/", "/app/pdf", "/app/image/", "/app/image"]
  }
}
