{
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/bergwork-pdf.desktop",
        "files": {
          "/usr/share/mime/packages/bergwork-pdf.xml": "linux/bergwork-pdf-mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/bergwork-pdf.desktop",
        "files": {
          "/usr/share/mime/packages/bergwork-pdf.xml": "linux/bergwork-pdf-mime.xml"
        }
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "berg:work PDF",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ]
  }
}
