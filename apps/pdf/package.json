{
  "name": "@bergwork/pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "bin": {
    "bergwork-pdf-cli": "cli/bin/bergwork-pdf-cli.mjs"
  },
  "scripts": {
    "build:web": "node scripts/build-frontend.mjs",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "licenses": "node scripts/collect-licenses.mjs --notices",
    "licenses:check": "node scripts/collect-licenses.mjs --check",
    "build:editor": "node scripts/build-editor.mjs",
    "fork:status": "node scripts/editor-fork.mjs status",
    "fork:port": "node scripts/editor-fork.mjs port",
    "fork:check": "node scripts/editor-fork.mjs check",
    "dev": "vite",
    "test:corpus:fetch": "node tests/corpus/fetch-corpus.mjs",
    "test:corpus:quick": "node tests/run-corpus.mjs --tier quick",
    "test:corpus": "node tests/run-corpus.mjs --tier sample",
    "test:corpus:full": "node tests/run-corpus.mjs --tier full",
    "test:corpus:ui": "node tests/ui-smoke.mjs",
    "test:ui-matrix": "node tests/ui-matrix/run-matrix.mjs --tier quick",
    "test:ui-matrix:full": "node tests/ui-matrix/run-matrix.mjs --tier full",
    "test:walk": "node tests/ui-matrix/run-walk.mjs --minutes 10",
    "test:walk:long": "node tests/ui-matrix/run-walk.mjs --minutes 120",
    "test:fuzz": "node tests/fuzz/run-commands.mjs --seconds 60",
    "test:unit": "node --test tests/unit/",
    "cli": "node cli/bin/bergwork-pdf-cli.mjs",
    "test:cli": "node --test --test-concurrency=1 cli/test/"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@vitejs/plugin-react": "6.1.1",
    "bidi-js": "1.0.3",
    "diff": "5.2.2",
    "esbuild": "0.24.2",
    "harfbuzzjs": "1.4.0",
    "jszip": "3.10.1",
    "node-forge": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfstudio": "0.4.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  }
}
