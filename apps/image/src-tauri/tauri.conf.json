{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "berg:work Image",
  "version": "0.1.0",
  "identifier": "de.fernwork.bildeditor",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --config src-tauri/frontend/vite.config.ts",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build --config src-tauri/frontend/vite.config.ts",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: https://huggingface.co https://*.huggingface.co https://*.hf.co"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["fwimg"],
        "name": "Fernwork image project",
        "description": "berg:work Image project",
        "role": "Editor",
        "mimeType": "application/vnd.fernwork.image"
      },
      {
        "ext": ["psd", "psb"],
        "name": "Photoshop document",
        "description": "Layered image document",
        "role": "Editor",
        "mimeType": "image/vnd.adobe.photoshop"
      },
      {
        "ext": ["png", "jpg", "jpeg", "webp", "avif", "gif", "tif", "tiff", "heic", "heif"],
        "name": "Image",
        "description": "Image file",
        "role": "Editor",
        "mimeType": "image/*"
      }
    ]
  }
}
